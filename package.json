{
  "name": "ai-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Forkable Next.js template featuring an AI-powered calendar app",
  "keywords": [
    "ai",
    "calendar",
    "nextjs",
    "react",
    "template"
  ],
  "license": "MIT",
  "author": "kyh",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyh/ai-calendar"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "test": "node -e \"if(require('node:fs').globSync('src/**/*.test.ts').length===0){console.error('no test files match src/**/*.test.ts');process.exit(1)}\" && node --import tsx --test 'src/**/*.test.ts'",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "eve": "^0.47.3",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@kyh/oxlint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}

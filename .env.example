# Vercel AI Gateway key — https://vercel.com/docs/ai-gateway
# Used automatically in development. In production, visitors bring their own
# key (or use the "demo" key in the UI for a scripted client-side reply).
AI_GATEWAY_API_KEY=

# Optional: a shared sentinel value. When a client sends this string as its
# gateway key, the server swaps in AI_GATEWAY_API_KEY above.
SECRET_KEY=
